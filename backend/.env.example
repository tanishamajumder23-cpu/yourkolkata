# ---------------------------------------------------------------------------
# Backend environment variables
# Copy this file to `.env` and fill in your own keys. Nothing is hardcoded.
#
# Until BOTH keys below are provided, the backend runs in MOCK MODE:
#   - /api/suggest      -> returns hand-written mock suggestions (no Groq/Places)
#   - /api/itinerary/build -> uses estimated travel times (no Google Directions)
# Every mock path is clearly logged on the server and flagged in the API
# response via a `mock: true` field so you know exactly what still needs a key.
# ---------------------------------------------------------------------------

# Groq API key — powers /api/suggest (the ONLY AI provider in this project).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Groq model to use (optional; sensible default is applied if left blank).
GROQ_MODEL=llama-3.3-70b-versatile

# Google Maps Platform key — must have BOTH "Places API" and
# "Directions API" enabled. Used by /api/suggest (place details + photos)
# and /api/itinerary/build (travel times between stops).
# Get one at https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# Server port (optional)
PORT=4000
